import 'subject_files.dart';

CREATE TABLE pdf_search_metadata (
  file_id INTEGER NOT NULL PRIMARY KEY REFERENCES subject_files (id) ON DELETE CASCADE,
  status TEXT NOT NULL,
  page_count INTEGER NOT NULL DEFAULT 0,
  indexed_at INTEGER NOT NULL,
  -- Highest page number already extracted into pdf_page_fts for this file.
  -- An interrupted run resumes from last_indexed_page + 1 instead of wiping
  -- the pages it already stored.  0 means "nothing extracted yet".
  last_indexed_page INTEGER NOT NULL DEFAULT 0
);

CREATE VIRTUAL TABLE pdf_page_fts USING fts5(
  file_id UNINDEXED,
  page_number UNINDEXED,
  page_text,
  tokenize='porter unicode61'
);
