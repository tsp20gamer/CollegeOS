<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/college_os_widget_background"
    android:clickable="true"
    android:contentDescription="@string/college_os_widget_description"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/widget_class_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.12"
        android:maxLines="1"
        android:text="@string/widget_next_class"
        android:textColor="@color/widget_primary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_class_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/app_name"
        android:textColor="@color/widget_on_surface"
        android:textSize="21sp" />

    <TextView
        android:id="@+id/widget_class_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_class_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_attendance_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:background="@color/widget_outline" />

    <LinearLayout
        android:id="@+id/widget_attendance_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_attendance_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.10"
                android:maxLines="1"
                android:text="@string/widget_today_attendance"
                android:textColor="@color/widget_primary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_attendance_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/widget_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_attendance_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_open_to_refresh"
            android:textColor="@color/widget_on_surface"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/widget_attendance_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/widget_primary"
            android:progressBackgroundTint="@color/widget_outline" />

        <TextView
            android:id="@+id/widget_attendance_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
